{
  "expo": {
    "name": "A.C.D.C",
    "slug": "energyhome",
    "version": "1.0.0",
    "scheme": "energyhome",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.energyhome.app"
    },
    "android": {
      "package": "com.energyhome.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0052ff"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o $(PRODUCT_NAME) use a câmera para ler o QR Code do hub.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.381830661025-tdh144v1n10s5dadonpbii64d94rdsl0"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0052ff",
          "defaultChannel": "alertas"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ContaProjetada",
              "label": "Conta do mês",
              "description": "Conta estimada e projeção do mês (A.C.D.C)",
              "minWidth": "200dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9ff",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "ea5c7844-779d-4a05-871c-018d62666f6f"
      }
    }
  }
}
