{
  "expo": {
    "name": "A.C.D.C",
    "slug": "energyhome",
    "version": "1.0.0",
    "scheme": "energyhome",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.energyhome.app"
    },
    "android": {
      "package": "com.energyhome.app",
      "adaptiveIcon": {
        "backgroundColor": "#f8f9ff"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o $(PRODUCT_NAME) use a câmera para ler o QR Code do hub.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.381830661025-tdh144v1n10s5dadonpbii64d94rdsl0"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0052ff",
          "defaultChannel": "alertas"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea5c7844-779d-4a05-871c-018d62666f6f"
      }
  }
}
}