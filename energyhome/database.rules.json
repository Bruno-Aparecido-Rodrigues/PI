{
  "rules": {
    "hubs": {
      ".indexOn": [
        "unclaimedAt"
      ],
      "$hubId": {
        ".read": "auth != null && data.child('owners').child(auth.uid).exists()",
        "registered": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "newData.isNumber()"
        },
        "claimed": {
          ".read": true,
          ".write": "auth != null && (data.parent().child('owners').child(auth.uid).exists() || newData.parent().child('owners').child(auth.uid).exists())",
          ".validate": "newData.isBoolean() && newData.val() == newData.parent().child('owners').hasChildren()"
        },
        "unclaimedAt": {
          ".read": true,
          ".write": "auth != null && (data.parent().child('owners').child(auth.uid).exists() || newData.parent().child('owners').child(auth.uid).exists())",
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "current": {
          ".write": "newData.exists() || (auth != null && newData.parent().child('owners').child(auth.uid).exists() && data.parent().child('unclaimedAt').isNumber() && data.parent().child('unclaimedAt').val() < now - 15552000000)",
          ".validate": "newData.hasChildren(['watts', 'updatedAt'])",
          "watts": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "readings": {
          ".write": "!newData.exists() && auth != null && newData.parent().child('owners').child(auth.uid).exists() && data.parent().child('unclaimedAt').isNumber() && data.parent().child('unclaimedAt').val() < now - 15552000000",
          ".indexOn": "timestamp",
          "$readingId": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['watts', 'timestamp'])",
            "watts": {
              ".validate": "newData.isNumber()"
            },
            "energyKwh": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "simulado": {
              ".validate": "newData.isBoolean()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "alerts": {
          ".write": "!newData.exists() && auth != null && newData.parent().child('owners').child(auth.uid).exists() && data.parent().child('unclaimedAt').isNumber() && data.parent().child('unclaimedAt').val() < now - 15552000000",
          ".indexOn": "timestamp",
          "$alertId": {
            ".write": "auth != null && root.child('hubs').child($hubId).child('owners').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['templateId', 'timestamp', 'read'])",
            "templateId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "read": {
              ".validate": "newData.isBoolean()"
            },
            "detalhe": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "aprendizadoAte": {
        ".write": "auth != null && root.child('hubs').child($hubId).child('owners').child(auth.uid).exists()",
        ".validate": "newData.isNumber()"
      },
      "settings": {
          ".write": "auth != null && root.child('hubs').child($hubId).child('owners').child(auth.uid).exists() || (!newData.exists() && auth != null && newData.parent().child('owners').child(auth.uid).exists() && data.parent().child('unclaimedAt').isNumber() && data.parent().child('unclaimedAt').val() < now - 15552000000)",
          "tariff": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100"
          },
          "tarifaModo": {
            ".validate": "newData.val() === 'manual' || newData.val() === 'aneel'"
          },
          "distribuidora": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "icms": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
          },
          "pisCofins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
          },
          "cip": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "ciclo": {
            ".validate": "newData.hasChildren(['ultimaLeitura', 'proximaLeitura']) && newData.child('proximaLeitura').val() > newData.child('ultimaLeitura').val()",
            "ultimaLeitura": {
              ".validate": "newData.isNumber()"
            },
            "proximaLeitura": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "aneel": {
            ".validate": "newData.hasChildren(['tarifaKwh', 'atualizadoEm'])",
            "tarifaKwh": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100"
            },
            "atualizadoEm": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "owners": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || (!data.parent().exists() && root.child('hubs').child($hubId).child('registered').exists()))",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().beginsWith('ExponentPushToken[') && newData.val().length <= 200"
      }
    },
    "alertasWorker": {
      ".read": false,
      ".write": false
    }
  }
}
