{
  "rules": {
    "hubs": {
      "$hubId": {
        ".read": "auth != null && data.child('owners').child(auth.uid).exists()",

        "registered": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "newData.isNumber()"
        },

        "claimed": {
          ".read": true,
          ".write": "auth != null && (data.parent().child('owners').child(auth.uid).exists() || newData.parent().child('owners').child(auth.uid).exists())",
          ".validate": "newData.isBoolean() && newData.val() == newData.parent().child('owners').hasChildren()"
        },

        "current": {
          ".write": "newData.exists()",
          ".validate": "newData.hasChildren(['watts', 'updatedAt'])",
          "watts": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "readings": {
          ".indexOn": "timestamp",
          "$readingId": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['watts', 'timestamp'])",
            "watts": { ".validate": "newData.isNumber()" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "alerts": {
          ".indexOn": "timestamp",
          "$alertId": {
            ".write": "auth != null && root.child('hubs').child($hubId).child('owners').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['templateId', 'timestamp', 'read'])",
            "templateId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "read": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "settings": {
          ".write": "auth != null && root.child('hubs').child($hubId).child('owners').child(auth.uid).exists()",
          "tariff": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100" }
        },

        "owners": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || (!data.parent().exists() && root.child('hubs').child($hubId).child('registered').exists()))",
            ".validate": "newData.val() === true"
          }
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "pushTokens": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString()"
      }
    }
  }
}
